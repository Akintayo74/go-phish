{
  "name": "cat-sim",
  "version": "0.1.0",
  "private": true,
  "description": "CAT-Sim: consent-based phishing simulation + cybersecurity awareness training platform",
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "bootstrap": "npm run bootstrap --workspace backend",
    "start": "npm start --workspace backend",
    "migrate:latest": "npm run migrate:latest --workspace backend",
    "seed:run": "npm run seed:run --workspace backend",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm --prefix e2e test",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend"
  },
  "engines": {
    "node": ">=20"
  }
}
