# CAT-Sim environment configuration (root reference).
# Copy to backend/.env for local development. NEVER commit a real .env.
#
# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# The simulation DB must be fully separate from any production/customer system.
DATABASE_URL=postgres://catsim:catsim@localhost:5432/catsim_dev

# --- Data protection (Phase 1) ---
# Secret for HMAC-hashing participant contact identifiers so raw email/phone is
# never stored. MUST be a long random value in any real deployment.
IDENTITY_HASH_SECRET=change-me-to-a-long-random-string

# --- Auth (Phase 3) ---
# Secret for signing admin-session JWTs. MUST be a long random value in any real
# deployment, or admin sessions can be forged.
JWT_SECRET=change-me-to-a-long-random-string
# Admin session lifetime in seconds (default 8h).
JWT_EXPIRES_IN_SECONDS=28800

# --- Simulated landing page (Phase 4) ---
# A GENERIC, FICTIONAL brand for the dummy login page. It must NEVER impersonate
# a real organization or brand; the default is an obvious placeholder.
SIM_BRAND_NAME=ACME Corp — Staff Portal
# Where the disclosure page's "go to training" link points.
#
# QUOTE THIS VALUE. An unquoted # starts an inline comment in a .env file, so
# SIM_TRAINING_URL=/#/learn silently parses as "/" and the training link 404s.
#
# It is resolved against THIS service's origin. In DEVELOPMENT the CAT site is
# served by Vite on :5173, a different origin from this API, so the value must be
# ABSOLUTE. In a single-origin DEPLOYMENT the API serves the app too, so the
# relative default (/#/learn) is already correct -- leave it unset there.
SIM_TRAINING_URL="http://localhost:5173/#/learn"

# --- Interaction tracking + campaign delivery (Phase 5) ---
# Externally reachable origin the per-participant tracking links resolve
# against. MUST be the real public URL in a deployment (not localhost) -- this is
# the origin a participant's mail client resolves, so getting it wrong mails out
# links pointing at localhost. If unset, config falls back to the host platform's
# own external URL (RENDER_EXTERNAL_URL) before the localhost default.
PUBLIC_BASE_URL=http://localhost:4000
# Email provider. 'console' is hermetic (records metadata only, sends nothing)
# and is the default for local/dev/CI; set a transactional provider in prod.
MAIL_PROVIDER=console
# Generic/fictional From-address — must NOT impersonate a real organization.
MAIL_FROM=IT Service Desk <no-reply@catsim.invalid>
# API key for a real mail provider (blank for the console provider). Never logged.
MAIL_API_KEY=
# Outbound send throttle in messages/second (respects provider rate limits).
SEND_RATE_PER_SECOND=10

# --- Automatic enrollment loop (Phase 8) ---
# The PUBLISHED module a participant is auto-assigned on meeting a campaign's
# enrollment trigger (click/submit).
ENROLLMENT_MODULE_SLUG=recognizing-phishing
# Advisory interval (days) before recommending a re-simulation of a participant
# who completed their training. A hook only — nothing is sent automatically.
RESIMULATION_INTERVAL_DAYS=90

# --- Analytics dashboard (Phase 9) ---
# Small-group suppression threshold (k-anonymity, guardrail #5). A
# cohort/department group with fewer participants than this is never reported
# with its own counts; such groups collapse into one suppressed summary. Min 2.
ANALYTICS_MIN_GROUP_SIZE=5

# --- SMTP transport (used when MAIL_PROVIDER=smtp) ---
# Local development: run a mail catcher so simulated mail is real mail but can
# never reach a real person:
#   docker run -d --name catsim-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# then read the inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for an implicit-TLS relay on :465. STARTTLS on :587 uses false.
SMTP_SECURE=false
# Leave blank for a local catcher. A real relay needs both (SendGrid uses the
# literal user "apikey" and the API key as the password). SMTP_PASS is never logged.
SMTP_USER=
SMTP_PASS=

# --- Single-origin static hosting (deployment) ---
# Path to the built React app. When this directory exists, the API also serves
# the SPA from the same origin -- which is how CAT-Sim deploys, because the
# client calls the API with RELATIVE paths and the app registers no CORS
# middleware. Defaults to ../frontend/dist (absent in dev, where Vite serves the
# app on :5173 and proxies /api back here). Set to an empty value for an
# API-only deployment behind a separate host that rewrites /api, /t and /sim.
# FRONTEND_DIST=

# --- Seeding ---
# Password for the demo operator accounts. Under NODE_ENV=production the seed
# REFUSES to run without this rather than installing the dev password that is
# published in this repository.
# SEED_ADMIN_PASSWORD=
#
# Controls `npm run bootstrap` (migrate + conditional seed), which runs from the
# start command in a deployment. The seeds are DESTRUCTIVE -- they clear cohorts,
# participants and interactions -- so this must not be loosened casually:
#   auto (default)  seed only a database that has never been seeded
#   never           migrate only
#   force           reseed unconditionally, DISCARDING collected data
# SEED_ON_BOOT=auto

# --- Database TLS ---
# Managed Postgres over a public network needs TLS; knexfile.js enables it for
# NODE_ENV=production. Set PGSSLMODE=disable when the connection stays on a
# provider's private network (Render's *internal* database URL is that case).
# PGSSLMODE=

# --- Frontend origin ---
# Where the React app (admin console, CAT learning site, and the participant
# training view at #/enroll/<token>) is served. Defaults to PUBLIC_BASE_URL, so
# set it ONLY when the frontend is served separately from this API — which is
# the case for the Vite dev server, and for any deployment with a static host.
# Getting this wrong makes the training link in the enrollment email 404.
APP_BASE_URL=http://localhost:5173
