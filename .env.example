# CAT-Sim environment configuration (root reference).
# Copy to backend/.env for local development. NEVER commit a real .env.
#
# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# The simulation DB must be fully separate from any production/customer system.
DATABASE_URL=postgres://catsim:catsim@localhost:5432/catsim_dev

# --- Data protection (Phase 1) ---
# Secret for HMAC-hashing participant contact identifiers so raw email/phone is
# never stored. MUST be a long random value in any real deployment.
IDENTITY_HASH_SECRET=change-me-to-a-long-random-string

# --- Auth (Phase 3) ---
# Secret for signing admin-session JWTs. MUST be a long random value in any real
# deployment, or admin sessions can be forged.
JWT_SECRET=change-me-to-a-long-random-string
# Admin session lifetime in seconds (default 8h).
JWT_EXPIRES_IN_SECONDS=28800

# --- Simulated landing page (Phase 4) ---
# A GENERIC, FICTIONAL brand for the dummy login page. It must NEVER impersonate
# a real organization or brand; the default is an obvious placeholder.
SIM_BRAND_NAME=ACME Corp — Staff Portal
# Where the disclosure page's training link points (defaults to the public CAT
# learning site added in Phase 6). Set an absolute URL if the CAT site is served
# from a different origin than this service.
SIM_TRAINING_URL=/#/learn

# --- Interaction tracking + campaign delivery (Phase 5) ---
# Externally reachable origin the per-participant tracking links resolve
# against. MUST be the real public URL in a deployment (not localhost).
PUBLIC_BASE_URL=http://localhost:4000
# Email provider. 'console' is hermetic (records metadata only, sends nothing)
# and is the default for local/dev/CI; set a transactional provider in prod.
MAIL_PROVIDER=console
# Generic/fictional From-address — must NOT impersonate a real organization.
MAIL_FROM=IT Service Desk <no-reply@catsim.invalid>
# API key for a real mail provider (blank for the console provider). Never logged.
MAIL_API_KEY=
# Outbound send throttle in messages/second (respects provider rate limits).
SEND_RATE_PER_SECOND=10

# --- Automatic enrollment loop (Phase 8) ---
# The PUBLISHED module a participant is auto-assigned on meeting a campaign's
# enrollment trigger (click/submit).
ENROLLMENT_MODULE_SLUG=recognizing-phishing
# Advisory interval (days) before recommending a re-simulation of a participant
# who completed their training. A hook only — nothing is sent automatically.
RESIMULATION_INTERVAL_DAYS=90
