# Backend environment. Copy to backend/.env for local dev. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://catsim:catsim@localhost:5432/catsim_dev

# Secret for HMAC-hashing participant contact identifiers (Phase 1).
# MUST be overridden with a long random value in any real deployment.
IDENTITY_HASH_SECRET=change-me-to-a-long-random-string

# Secret for signing admin-session JWTs (Phase 3).
# MUST be overridden with a long random value in any real deployment, or admin
# sessions can be forged.
JWT_SECRET=change-me-to-a-long-random-string
# Admin session lifetime in seconds (default 8h).
JWT_EXPIRES_IN_SECONDS=28800

# Simulated landing page (Phase 4). A GENERIC, FICTIONAL brand for the dummy
# login page — it must NEVER impersonate a real organization or brand.
SIM_BRAND_NAME=Meridian Trust Bank — Staff Portal
# Where the disclosure page's "go to training" link points.
#
# QUOTE THIS VALUE. An unquoted # starts an inline comment in a .env file, so
# SIM_TRAINING_URL=/#/learn silently parses as "/" and the training link 404s.
#
# It is also resolved against THIS service's origin. The CAT site is served by
# the frontend (Vite on :5173 in dev, a static host in production), NOT by this
# API, so it must be an ABSOLUTE url pointing at wherever the CAT site lives.
SIM_TRAINING_URL="http://localhost:5173/#/learn"

# Interaction tracking + campaign delivery (Phase 5).
# Externally reachable origin the tracked links resolve against. MUST be the
# real public URL of this service in a deployment (not localhost), or the links
# in participants' emails will not resolve.
PUBLIC_BASE_URL=http://localhost:4000
# Email provider. 'console' is hermetic (records metadata only, sends nothing)
# and is the default for local/dev/CI. Set a transactional provider + key in a
# real deployment.
MAIL_PROVIDER=console
# Generic/fictional From-address — must NOT impersonate a real organization.
MAIL_FROM=IT Service Desk <no-reply@catsim.invalid>
# API key for a real mail provider (leave blank for the console provider). Never
# logged.
MAIL_API_KEY=
# Outbound send throttle in messages/second (respects provider rate limits).
SEND_RATE_PER_SECOND=10

# Automatic enrollment loop (Phase 8).
# The PUBLISHED learning module a participant is auto-assigned when they meet a
# campaign's enrollment trigger (click/submit). Must be a published module slug.
ENROLLMENT_MODULE_SLUG=recognizing-phishing
# Advisory interval (days) before re-simulating a participant who has completed
# their assigned training. A hook only — nothing is dispatched automatically.
RESIMULATION_INTERVAL_DAYS=90

# Analytics dashboard (Phase 9).
# Small-group suppression threshold (k-anonymity, guardrail #5). Any
# cohort/department group with fewer than this many participants is never
# reported with its own counts (a group of one would out that individual);
# such groups collapse into a single suppressed summary. Must be >= 2.
ANALYTICS_MIN_GROUP_SIZE=5

# --- SMTP transport (used when MAIL_PROVIDER=smtp) ---
# Local development: run a mail catcher so simulated mail is real mail but can
# never reach a real person:
#   docker run -d --name catsim-mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# then read the inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# true only for an implicit-TLS relay on :465. STARTTLS on :587 uses false.
SMTP_SECURE=false
# Leave blank for a local catcher. A real relay needs both (SendGrid uses the
# literal user "apikey" and the API key as the password). SMTP_PASS is never logged.
SMTP_USER=
SMTP_PASS=

# --- Frontend origin ---
# Where the React app (admin console, CAT learning site, and the participant
# training view at #/enroll/<token>) is served. Defaults to PUBLIC_BASE_URL, so
# set it ONLY when the frontend is served separately from this API — which is
# the case for the Vite dev server, and for any deployment with a static host.
# Getting this wrong makes the training link in the enrollment email 404.
APP_BASE_URL=http://localhost:5173
